# Copy to .env and fill in. .env is git-ignored — never commit a filled-in copy.

# The two webhook URLs off the trigger step of your claim and complete workflows
# in Tray (see "The Tray side you build" in README.md).
#
# THESE ARE THE ONLY CREDENTIAL THE BOT HAS. Anyone holding the claim URL can
# name an automation and make this bot run it; anyone holding the complete URL
# can settle a job with a result of their choosing. Treat both as passwords.
TRAY_CLAIM_URL=
TRAY_COMPLETE_URL=

# Which queue this bot drinks from. A workflow enqueues into a lane and only a
# bot on that lane can claim it. Two bots on one lane load-balance; two bots with
# DIFFERENT automations on one lane will fail each other's jobs.
BOT_LANE=bot

POLL_SECONDS=5
JOB_TIMEOUT_SECONDS=300
HEADLESS=true

# Set HEADLESS=false and run outside Docker to watch an automation work. Much
# the fastest way to debug a selector.

# --- per-automation secrets ---------------------------------------------------
# Each automation declares what it needs in `meta.secrets`; the runner resolves
# them from here BEFORE launching a browser, so a missing one fails in a sentence
# rather than as a timeout on a login page.
#
# PORTAL_USERNAME=
# PORTAL_PASSWORD=
